rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Global Default Deny Safety Net
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Voice recordings of chapter recitations: recordings/{userId}/{recordingId}.<ext>
    // Private to the owner (mirrors firestore.rules' users/{userId}/recordings) —
    // capped at 50MB and audio-only to bound storage cost and reject non-audio uploads.
    match /recordings/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // create/update (i.e. uploads) go through request.resource's size/type
      // checks; delete has no request.resource (nothing is being written), so
      // it needs its own, simpler rule — otherwise those checks evaluate
      // against a null resource and every delete gets denied.
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Bible page photos: chapterPhotos/{userId}/{fileName}
    // Both the full image and its _thumb variant live here. Owner-only, with
    // no read path for anyone else -- see firestore.rules for why sharing is
    // deliberately absent.
    match /chapterPhotos/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // 8MB is deliberately generous: the client downscales to a 2000px long
      // edge before uploading, which lands around 400KB. Anything approaching
      // this cap means the prepare step was bypassed and SHOULD be rejected.
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // Same split as recordings above, for the same reason: delete carries no
      // request.resource, so folding it in with create/update would evaluate
      // the size/type checks against null and deny every single delete.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
