rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helper Functions ---
    
    // Checks if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the user is the owner of the document being requested
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Prevent ID Poisoning by verifying document ID format and size
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Collection Matching and Access Rules ---

    // Users and Profiles collection. Read is open to any signed-in user (not
    // just the owner) so real circle co-members can see each other's name,
    // avatar, and streak — write stays owner-only. Because anyone can list
    // this collection, nothing private may live here: email used to, and
    // was dumpable by any signed-in user. It now lives only in emailLookup
    // (below), which can be fetched by exact address but never listed.
    // circleIds is still written here by each user for their own
    // bookkeeping, but it is self-reported -- no rule may trust it for
    // access (see dmGated, which checks real member docs instead).
    match /profiles/{userId} {
      allow read: if isSignedIn();
      // sharedMemoryQueue may no longer be written here (it moved to
      // shared/memoryQueue, below) -- this stops an old app build from
      // putting the friends-only list back on the listable profile.
      // On update only adding/changing it is refused, so a profile that
      // still has the old field can be written (and the field deleted).
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['sharedMemoryQueue']);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).addedKeys()
             .union(request.resource.data.diff(resource.data).changedKeys())
             .hasAny(['sharedMemoryQueue']);
      allow delete: if isOwner(userId);
    }

    // The "Friends" verse-list snapshot (Settings > who can see my verses).
    // It used to sit on the profile doc above as sharedMemoryQueue, but that
    // doc is listable by anyone signed in, so "friends only" wasn't true.
    // It lives here instead, readable only by the owner and by people who
    // really are their friend (a friends doc, which only an accepted
    // request can create). isFriendOf is defined further down.
    match /profiles/{userId}/shared/memoryQueue {
      allow read: if isOwner(userId) || (isSignedIn() && isFriendOf(request.auth.uid, userId));
      allow write: if isOwner(userId);
    }

    // Find Friends' exact-email search. Doc id is the lowercased address,
    // body is just the owner's uid. `get` only, never `list`: you can look
    // up someone whose address you already know, but you can't enumerate
    // addresses. Only the account holding that address (per the auth
    // token, not anything client-written) can claim it.
    match /emailLookup/{email} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.auth.token.email is string
        && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Memory plans collection
    match /memoryPlans/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User verses collection (nested under users/{userId})
    match /users/{userId}/verses/{verseId} {
      allow read, write: if isOwner(userId);
    }

    // Unified Memory Queue collection
    match /users/{userId}/memoryQueue/{verseId} {
      allow read, write: if isOwner(userId);
    }

    // Voice recordings of chapter recitations. This is always the private,
    // owner-only source of truth regardless of sharedVisibility — sharing
    // works by ALSO writing a denormalized copy to sharedRecordings (below),
    // never by opening this collection itself up to other users.
    match /users/{userId}/recordings/{recordingId} {
      allow read, write: if isOwner(userId);
    }

    // Photos of the user's own physical Bible pages, attached to a chapter.
    // Owner-only, and unlike recordings above there is NO shared counterpart
    // collection anywhere -- these are never shareable. A page photo
    // reproduces a copyrighted translation and routinely carries handwriting,
    // marginalia, and family-register names, so the sharing path is absent by
    // design rather than merely switched off. Adding one is a product
    // decision, not a rules tweak.
    match /users/{userId}/chapterPhotos/{photoId} {
      allow read, write: if isOwner(userId);
    }

    // Denormalized, read-only-to-others copy of a recording once its owner
    // sets sharedVisibility to 'circle' or 'public'. Firestore rules can't
    // cheaply check "is this reader a co-member of ANY of the owner's
    // circles" (no loops over arbitrary-length lists), so instead of a live
    // check, sharedWithUids is a snapshot of exactly who could see it at
    // share time (circle co-members + friends) — checked with the built-in
    // hasAny() array operator, no loop needed. A later-joining circle member
    // won't retroactively see older shares; new shares include them.
    match /sharedRecordings/{recordingId} {
      allow read: if isSignedIn() &&
        (resource.data.visibility == 'public' ||
         isOwner(resource.data.ownerId) ||
         resource.data.sharedWithUids.hasAny([request.auth.uid]));
      // Update checks the EXISTING doc's owner too, not just the incoming
      // one -- otherwise anyone could overwrite someone else's shared copy
      // simply by writing their own uid into ownerId.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // The /sharedPlans collection was removed along with the whole
    // retention-sharing feature (publish/browse/join someone else's Review
    // Settings). No rule is left for it deliberately: with no match block,
    // the default deny applies, so any leftover client or stale doc can
    // neither be read nor written.

    // Real, mutual, persistent friend connections — independent of circle
    // membership (unlike circleFriends, which is just live-recomputed
    // co-membership). A friendship is two docs (one per direction), written
    // together by whichever side accepts — allow create/delete by either the
    // path owner (userId) or the referenced friend (friendUid) so one
    // client-side batch can write/remove both sides atomically.
    //
    // Create additionally requires that the SAME write accepts a friend
    // request between the two (see acceptedInThisWrite). Without that, being
    // "either side" was enough, so anyone could make themselves anyone's
    // friend -- and friendship unlocks DMs, nudges, and friends-only shares.
    // Delete stays either-side with no extra check: unfriending never needs
    // the other person's consent.
    function acceptedInThisWrite(requestId) {
      let path = /databases/$(database)/documents/friendRequests/$(requestId);
      return existsAfter(path)
        && getAfter(path).data.status == 'accepted'
        && getAfter(path).data.respondedAt == request.time;
    }

    match /profiles/{userId}/friends/{friendUid} {
      allow read: if isSignedIn();
      allow create: if (isOwner(userId) || isOwner(friendUid))
        && userId != friendUid
        && request.resource.data.uid == friendUid
        && (acceptedInThisWrite(userId + '_' + friendUid) || acceptedInThisWrite(friendUid + '_' + userId));
      allow delete: if isOwner(userId) || isOwner(friendUid);
      allow update: if false;
    }

    // Friend requests: created by the sender, only the recipient can
    // accept/decline (update), either side can read or cancel/clear it.
    // Doc id is always `${fromUid}_${toUid}` (checked) so a request can't be
    // planted under an id that impersonates a different pair.
    //
    // Accepting/declining must stamp respondedAt with the server's clock
    // (serverTimestamp() == request.time). That stamp is what the friends
    // rule above checks, so an old 'accepted' request lying around after an
    // unfriend can't be replayed later to re-create the friendship -- only a
    // fresh accept by the recipient can.
    //
    // Read allows a nonexistent doc for the same reason dmThreads does
    // (getDoc of a missing doc must not come back permission-denied):
    // removeFriend checks both possible request ids before deleting them.
    match /friendRequests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn() && (
        // Recipient accepting/declining -- nothing else on the doc may change.
        (resource.data.toUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.respondedAt == request.time)
        // Sender re-sending over their own old request (declined, or left
        // over from an earlier friendship) -- always lands back on pending,
        // which by itself grants nothing.
        || (resource.data.fromUid == request.auth.uid
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.status == 'pending')
      );
      allow delete: if isSignedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // 1:1 "race this passage" challenges -- modeled on friendRequests just
    // above: created by the sender (fromUid), only the recipient (toUid) can
    // accept/decline, either side can read/cancel. Once active, each side may
    // only ever patch their OWN progress counter (fromProgress for fromUid,
    // toProgress for toUid) -- same narrow-diff posture as the
    // accountabilityMeta counter below -- plus status, since a progress
    // update is also what flips status to 'completed' once both sides are
    // known (client-side) to have hit totalVerses.
    match /challenges/{challengeId} {
      // Includes the participantUids check (not just fromUid/toUid) because
      // the always-on badge listener in useAppState queries with
      // `where('participantUids', 'array-contains', uid)` -- Firestore
      // rejects a list query outright unless the rule is provably satisfied
      // by the query's own filters, so the rule must reference the same field.
      allow read: if isSignedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || request.auth.uid in resource.data.participantUids);
      // Same gate as starting a DM (dmGated): you can only challenge a real
      // friend, or someone in a circle you're both really members of --
      // named on the challenge as viaCircleId, since a rule can't loop over
      // every circle. participantUids must be exactly the two people, so a
      // sender can't slip a third uid in and give them read access.
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids.hasAll([request.auth.uid, request.resource.data.toUid])
        && dmGated(request.auth.uid, request.resource.data.toUid,
                   request.resource.data.get('viaCircleId', null));
      allow update: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
        && (
          // Recipient accepting/declining.
          (resource.data.toUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']))
          // Either side patching only their own progress field (+ status, for the completed flip).
          || (request.auth.uid == resource.data.fromUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fromProgress', 'status']))
          || (request.auth.uid == resource.data.toUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['toProgress', 'status']))
        );
      // Either participant may delete at ANY status, not just 'pending'.
      // A finished/declined race is just clutter in the DM thread, and there
      // is nothing to protect: progress lives in each side's own memoryQueue,
      // so deleting the challenge doc never destroys memorization progress.
      allow delete: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // Accountability nudges (friend-only, sender-composed custom message,
    // deliberately separate from any messaging system). Immutable log except
    // the recipient may mark their own copy read, or delete it from their inbox.
    // "Friend-only" is enforced here, not just in the client: the sender must
    // really be friends with the recipient (a friends doc can only come from
    // an accepted request, see above), and the message is capped at
    // NUDGE_MAX (500 chars, matching sendAccountabilityNudge).
    match /accountabilityNudges/{nudgeId} {
      allow read: if isSignedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && isFriendOf(request.auth.uid, request.resource.data.toUid)
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500;
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.toUid == request.auth.uid;
    }

    // Sender's own private bookkeeping of "when did I last nudge this
    // friend" -- purely mine, nobody else ever reads or writes it, so this
    // is the simple owner-only shape (no cross-user complexity needed at all).
    match /profiles/{userId}/accountabilitySentLog/{friendUid} {
      allow read, write: if isOwner(userId);
    }

    // Recipient's today-so-far received-nudge counter -- the one doc in this
    // feature that a NON-owner (any friend about to send a nudge) needs to
    // read (to show/enforce the cap before sending) and increment. Deliberately
    // narrow: only `count`/`dateKey` may change, and count may only go up by
    // exactly 1 per write (or reset to 1 on a new dateKey) -- no Cloud
    // Functions in this project, so this is the same "reasonable client trust,
    // not paranoid" posture as the rest of this file, not airtight server
    // enforcement. Writes are limited to the owner's real friends, so a
    // stranger can't burn through someone's daily cap to silence them.
    match /profiles/{userId}/accountabilityMeta/counter {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isFriendOf(request.auth.uid, userId) && request.resource.data.count == 1;
      allow update: if isSignedIn() && isFriendOf(request.auth.uid, userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'dateKey'])
        && (request.resource.data.count == 1 || request.resource.data.count == resource.data.count + 1);
    }

    // Messaging: 1:1 DM threads gated by "friend OR shared circle membership",
    // re-checked server-side on every message (not just thread creation) --
    // this is what makes a thread go read-only the moment that gating
    // relationship disappears, with no separate "active" flag to trust.
    // threadId is the two participant uids sorted + joined with '_'.
    //
    // The shared-circle half of the gate used to compare the two profiles'
    // circleIds arrays -- but each user writes their own circleIds freely,
    // so anyone could copy a target's ids into their own profile and DM
    // them. It now checks real member docs (which only the join rules can
    // create) in ONE specific circle named on the thread (viaCircleId): a
    // rule can't loop over every circle, so the client picks the circle it
    // verified both people are in and records it on the thread.
    function isFriendOf(a, b) {
      return exists(/databases/$(database)/documents/profiles/$(a)/friends/$(b));
    }

    function sharesCircle(a, b, circleId) {
      return circleId is string
        && isCircleMember(circleId, a)
        && isCircleMember(circleId, b);
    }

    function dmGated(a, b, circleId) {
      return isFriendOf(a, b) || sharesCircle(a, b, circleId);
    }

    // Text cap for DM and circle chat messages (sendDMMessage /
    // sendCircleMessage enforce the same 2000 before sending).
    function isValidMessageText(text) {
      return text is string && text.size() > 0 && text.size() <= 2000;
    }

    match /dmThreads/{threadId} {
      // The client getDoc()s a thread by its deterministic id to check
      // whether it already exists before creating it. A get() request
      // Firestore denies always comes back to the client as
      // permission-denied, never a graceful "not found" -- there's no way
      // to distinguish "doc doesn't exist" from "denied" otherwise -- so a
      // nonexistent thread (resource == null) must be explicitly readable.
      // A thread that DOES exist stays participant-only.
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participantUids);
      // The id must be exactly the two participants joined, so a thread
      // can't be planted under some other pair's id.
      allow create: if isSignedIn()
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participantUids[0] != request.resource.data.participantUids[1]
        && threadId == request.resource.data.participantUids[0] + '_' + request.resource.data.participantUids[1]
        && dmGated(request.resource.data.participantUids[0], request.resource.data.participantUids[1],
                   request.resource.data.get('viaCircleId', null));
      // Only the thread preview fields change after creation -- participants
      // never change on an existing thread. viaCircleId may be re-pointed
      // (e.g. the circle it named was left, but the two still share
      // another), but only to a circle both really belong to.
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'viaCircleId'])
        && request.resource.data.get('lastMessage', '') is string
        && request.resource.data.get('lastMessage', '').size() <= 2000
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['viaCircleId'])
          || sharesCircle(resource.data.participantUids[0], resource.data.participantUids[1], request.resource.data.viaCircleId));

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participantUids;
        allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid
          && isValidMessageText(request.resource.data.text)
          && request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participantUids
          && dmGated(get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participantUids[0],
                     get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participantUids[1],
                     get(/databases/$(database)/documents/dmThreads/$(threadId)).data.get('viaCircleId', null));
        allow update, delete: if false;
      }

      // Emoji reactions -- a flat sibling of messages/ (not nested per-
      // message) so opening a thread only ever needs one extra listener.
      // Doc id is always `${messageId}_${uid}`, checked below so it can't be
      // spoofed to attribute a reaction to someone else; one reaction per
      // user per message (the client deletes-then-creates to change emoji,
      // which is why update is disallowed -- keeps this rule simple).
      match /reactions/{reactionId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participantUids;
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && reactionId == request.resource.data.messageId + '_' + request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participantUids
          && dmGated(get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participantUids[0],
                     get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participantUids[1],
                     get(/databases/$(database)/documents/dmThreads/$(threadId)).data.get('viaCircleId', null));
        allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    // Group chat auto-tied to a Circle -- members only, immutable messages.
    // The one exception to "immutable" is the leader deleting them, purely
    // so disbandCircle can clear the chat instead of leaving it orphaned.
    match /circles/{circleId}/messages/{messageId} {
      allow read: if isSignedIn() && isCircleMember(circleId, request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid
        && isValidMessageText(request.resource.data.text)
        && isCircleMember(circleId, request.auth.uid);
      allow delete: if isSignedIn() && isCircleOwner(circleId);
      allow update: if false;
    }

    // Same reaction shape as dmThreads' above, flat sibling of circles/{id}/messages.
    match /circles/{circleId}/reactions/{reactionId} {
      allow read: if isSignedIn() && isCircleMember(circleId, request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && reactionId == request.resource.data.messageId + '_' + request.auth.uid
        && isCircleMember(circleId, request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isCircleOwner(circleId));
      allow update: if false;
    }

    // Real memorization-milestone activity feed (Community). Read is open to
    // any signed-in user (matches profiles' posture — the feed is
    // friend-scoped at the client query level, not at the rule level).
    // Immutable event log: only the author can create their own event, and
    // nobody can edit/delete one after the fact.
    match /activityEvents/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // --- Circle helpers ---
    // getAfter (not get) for the circle doc: createCircle writes the circle,
    // its leader's member doc and its invite-code doc in ONE batch, and the
    // member/invite rules need to see the circle that batch is creating.
    // Outside that batch getAfter and get read the same thing.
    function circleAfter(circleId) {
      return getAfter(/databases/$(database)/documents/circles/$(circleId));
    }

    function isCircleMember(circleId, uid) {
      return exists(/databases/$(database)/documents/circles/$(circleId)/members/$(uid));
    }

    function isCircleOwner(circleId) {
      return get(/databases/$(database)/documents/circles/$(circleId)).data.ownerId == request.auth.uid;
    }

    // Public circles are browsable by anyone signed in; a private circle's
    // doc, member list and plans are visible only to its members.
    function canSeeCircle(circleId) {
      return get(/databases/$(database)/documents/circles/$(circleId)).data.isPublic == true
        || isCircleMember(circleId, request.auth.uid);
    }

    // Invite-code lookup for "join by code": doc id is the code, body is
    // just the circleId. Like emailLookup, `get` only and never `list`, so
    // knowing a code finds its circle but codes can't be enumerated -- the
    // circle docs themselves are no longer readable to non-members of a
    // private circle, so the old "query circles by inviteCode" lookup can't
    // work (and was exactly what leaked every code to everyone). Only a
    // member can create one, and only for the code the circle doc really
    // has, so nobody can squat a code or point it elsewhere. existsAfter
    // because createCircle writes the leader's member doc in the same batch;
    // any member may also backfill one for a circle made before this
    // collection existed (see loadActiveCircleData).
    match /circleInvites/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(code)
        && request.resource.data.keys().hasOnly(['circleId'])
        && request.resource.data.circleId is string
        && circleAfter(request.resource.data.circleId).data.inviteCode == code
        && existsAfter(/databases/$(database)/documents/circles/$(request.resource.data.circleId)/members/$(request.auth.uid));
      allow delete: if isSignedIn() && isCircleOwner(resource.data.circleId);
      allow update: if false;
    }

    // Scripture Circles: community/small-group pacing circles. Only the
    // original creator is ever a 'leader' (ownerId) — there's no
    // promote/demote feature yet, so member docs are immutable after
    // creation.
    //
    // Joining is enforced HERE, not just client-side: a public circle is
    // self-join, a private one needs its invite code written onto the new
    // member doc (checked against the circle's real inviteCode), and anyone
    // the leader removed is blocked by a banned/{uid} doc. Before this,
    // self-join worked on ANY circle and a kick could simply be undone by
    // rejoining.
    //
    // Read allows a nonexistent doc (resource == null) for the same reason
    // as dmThreads: a stale id in someone's own circleIds must come back
    // "not found", not permission-denied, so loadMyCircles can prune it.
    match /circles/{circleId} {
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.isPublic == true
        || resource.data.ownerId == request.auth.uid
        || isCircleMember(circleId, request.auth.uid)
      );
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        // Your own member doc is always readable (joinCircle checks it
        // before joining, even for a circle you can't otherwise see yet).
        // (canSeeCircle first: a list query can't bind memberId, so the
        // check that doesn't need it has to be the one that can pass.)
        allow read: if isSignedIn() && (canSeeCircle(circleId) || isOwner(memberId));
        // Self-service join -- see the block comment above.
        allow create: if isOwner(memberId)
          && request.resource.data.uid == memberId
          && !exists(/databases/$(database)/documents/circles/$(circleId)/banned/$(memberId))
          && (
            // The creator's own leader row, written alongside the circle.
            (request.resource.data.role == 'leader' && circleAfter(circleId).data.ownerId == memberId)
            || (request.resource.data.role == 'member'
              && (circleAfter(circleId).data.isPublic == true
                || request.resource.data.get('inviteCode', '') == circleAfter(circleId).data.inviteCode))
          );
        allow delete: if isOwner(memberId) // self-service leave
          || isCircleOwner(circleId); // or owner kicks
        allow update: if false;
      }

      // Written by the leader in the same batch as a kick (removeCircleMember)
      // and checked by the join rule above, so a removed member stays out.
      // The removed person may read their own entry (so the app can explain
      // why a rejoin failed); only the leader can lift it.
      match /banned/{bannedUid} {
        allow read: if isSignedIn() && (isCircleOwner(circleId) || isOwner(bannedUid));
        allow create, delete: if isSignedIn() && isCircleOwner(circleId) && bannedUid != request.auth.uid;
        allow update: if false;
      }

      match /groupPlans/{planId} {
        allow read: if isSignedIn() && canSeeCircle(circleId);
        allow write: if isSignedIn() && isCircleOwner(circleId);
      }

      // Open-enrollment group challenges -- unlike groupPlans/studyPlans
      // above, any member may create one (peer competition, not
      // leader-curated content), but only the creator can end/cancel it.
      match /challenges/{challengeId} {
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
        allow create: if isSignedIn()
          && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid))
          && request.resource.data.createdByUid == request.auth.uid;
        allow update: if isSignedIn()
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        // The circle's leader may also delete, so disbandCircle can clear
        // every challenge instead of orphaning them.
        allow delete: if isSignedIn() && (resource.data.createdByUid == request.auth.uid || isCircleOwner(circleId));

        // Self-owned participant doc, same shape/trust model as
        // profiles/{uid}/friends/{friendUid} -- each member can only ever
        // join/update their OWN entry, never another's. Delete is the one
        // exception: the challenge's creator may also delete any participant
        // doc, purely so deleteGroupChallenge can clear the subcollection
        // before removing its parent (Firestore has no cascading delete, and
        // an orphaned participants collection is unreachable-but-permanent).
        // The circle's leader gets the same delete right, for disbandCircle.
        match /participants/{uid} {
          allow read: if isSignedIn() && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
          allow create: if isOwner(uid) && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
          allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress']);
          allow delete: if isOwner(uid)
            || get(/databases/$(database)/documents/circles/$(circleId)/challenges/$(challengeId)).data.createdByUid == request.auth.uid
            || isCircleOwner(circleId);
        }
      }
    }

    // Scripture text library: translations/{translationId} (metadata) and
    // translations/{translationId}/books/{bookId}/chapters/{chapterNumber}
    // (verse text). Readable by everyone (including signed-out users browsing
    // scripture), never writable from the client — populated only by the
    // admin import script running with a service account, which bypasses
    // these rules entirely.
    match /translations/{translationId} {
      allow read: if true;
      allow write: if false;

      match /books/{bookId}/chapters/{chapterId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // api.bible's shared chapter cache and its monthly call counter.
    //
    // Denied to clients on BOTH operations, deliberately and explicitly. The
    // global default-deny at the top of this file already covers these paths,
    // so these blocks change no behaviour — they exist so the intent is
    // written down where someone would look before adding an allow rule.
    //
    // apiBibleCache holds LICENSED scripture text (CSB/NIV/NLT), which unlike
    // the public-domain text in translations/** above must never be
    // world-readable: the licence permits caching it on our servers, not
    // republishing it through an open endpoint. Only the fetchApiBibleChapter
    // Cloud Function touches these, and it runs with admin credentials that
    // bypass these rules entirely.
    match /apiBibleCache/{cacheId} {
      allow read, write: if false;
    }

    match /apiBibleUsage/{monthId} {
      allow read, write: if false;
    }

  }
}
